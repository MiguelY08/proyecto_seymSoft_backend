generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model access {
  id_access         Int       @id(map: "acceso_pkey") @default(autoincrement())
  id_user           Int
  start_date_access DateTime? @default(now()) @db.Timestamp(6)
  end_date_access   DateTime? @db.Timestamp(6)
  users             users     @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "acceso_id_usuario_fkey")
}

model assigned_permissions {
  id_permission  Int              @id(map: "permisos_asignados_pkey") @default(autoincrement())
  id_role        Int
  id_module      Int
  id_privilege   Int
  modules        modules          @relation(fields: [id_module], references: [id_module], onDelete: NoAction, onUpdate: NoAction, map: "permisos_asignados_id_modulo_fkey")
  privileges     privileges       @relation(fields: [id_privilege], references: [id_privilege], onDelete: NoAction, onUpdate: NoAction, map: "permisos_asignados_id_privilegio_fkey")
  roles          roles            @relation(fields: [id_role], references: [id_role], onDelete: NoAction, onUpdate: NoAction, map: "permisos_asignados_id_rol_fkey")
  employee_roles employee_roles[]

  @@unique([id_role, id_module, id_privilege], map: "permisos_asignados_id_rol_id_modulo_id_privilegio_key")
}

model banner_img {
  id_img           Int              @id(map: "imagenes_carrusel_pkey") @default(autoincrement())
  img_url          String           @unique(map: "imagenes_carrusel_ruta_imagen_key") @db.VarChar(255)
  disposition      Int
  id_status        Int
  creation_date    DateTime?        @default(dbgenerated("CURRENT_DATE")) @db.Date
  id_user          Int
  general_statuses general_statuses @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction, map: "imagenes_carrusel_estado_fkey")
  users            users            @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "imagenes_carrusel_id_usuario_fkey")
}

model barcodes {
  id_barcode              Int                       @id(map: "codigo_de_barras_pkey") @default(autoincrement())
  barcode                 String                    @unique(map: "codigo_de_barras_codigo_de_barras_key") @db.VarChar(100)
  barcode_type            String?                   @db.VarChar(50)
  stock                   Int?                      @default(0)
  id_product              Int
  products                products                  @relation(fields: [id_product], references: [id_product], onDelete: NoAction, onUpdate: NoAction, map: "codigo_de_barras_id_producto_fkey")
  non_conforming_products non_conforming_products[]
  purchase_details        purchase_details[]
  sale_return_details     sale_return_details[]
}

model categories {
  id_category             Int                       @id(map: "categorias_pkey") @default(autoincrement())
  category_name           String                    @unique(map: "categorias_nombre_categoria_key") @db.VarChar(100)
  id_status               Int?
  subcategories_count     Int?
  general_statuses        general_statuses?         @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction, map: "categorias_id_estado_fkey")
  non_conforming_products non_conforming_products[]
  products                products[]
  subcategories           subcategories[]
}

model clients {
  id_client             Int            @id(map: "clientes_pkey") @default(autoincrement())
  person_type           String         @db.VarChar(20)
  rut                   Boolean?       @default(false)
  codigo_ciu            String?        @db.VarChar(25)
  address               String?        @db.VarChar(255)
  contact_person_number BigInt?
  contact_person_name   String?        @db.VarChar(255)
  id_user               Int            @unique(map: "clientes_id_usuario_key")
  client_type           String?        @db.VarChar(20)
  credit                Decimal?       @db.Decimal(10, 2)
  credit_balance        Decimal?       @db.Decimal(10, 2)
  users                 users          @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "clientes_id_usuario_fkey")
  credits               credits[]
  sales_orders          sales_orders[]
}

model credit_statuses {
  id_credit_status   Int            @id(map: "estados_credito_pkey") @default(autoincrement())
  name_credit_status String         @unique(map: "estados_credito_nombre_key") @db.VarChar(50)
  credits            credits[]
  installments       installments[]
}

model credits {
  id_credit           Int             @id(map: "creditos_pkey") @default(autoincrement())
  id_sale             Int             @unique(map: "creditos_id_venta_key")
  due_date            DateTime        @db.Date
  interest_percentage Decimal?        @default(0) @db.Decimal(5, 2)
  applied_interest    Decimal?        @default(0) @db.Decimal(12, 2)
  new_total_debt      Decimal         @db.Decimal(12, 2)
  id_credit_status    Int
  id_customer         Int
  used_quota          Decimal?        @db.Decimal(10, 2)
  available_quota     Decimal?        @db.Decimal(10, 2)
  sales               sales           @relation(fields: [id_sale], references: [id_sale], onDelete: NoAction, onUpdate: NoAction, map: "creditos_id_venta_fkey")
  clients             clients         @relation(fields: [id_customer], references: [id_client], map: "fk_creditos_cliente")
  credit_statuses     credit_statuses @relation(fields: [id_credit_status], references: [id_credit_status], map: "fk_creditos_estado_credito")
  installments        installments[]
}

model employee_roles {
  id_employee_role       Int                  @id(map: "empleados_rol_pkey") @default(autoincrement())
  id_employee            Int                  @unique(map: "empleados_rol_id_empleado_key")
  id_assigned_permission Int
  employees              employees            @relation(fields: [id_employee], references: [id_employee], onDelete: NoAction, onUpdate: NoAction, map: "empleados_rol_id_empleado_fkey")
  assigned_permissions   assigned_permissions @relation(fields: [id_assigned_permission], references: [id_permission], onDelete: NoAction, onUpdate: NoAction, map: "empleados_rol_id_permisos_asignados_fkey")
}

model employees {
  id_employee      Int               @id(map: "empleados_pkey") @default(autoincrement())
  id_user          Int               @unique(map: "empleados_id_usuario_key")
  id_status        Int?
  employee_roles   employee_roles?
  general_statuses general_statuses? @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction, map: "empleados_id_estado_fkey")
  users            users             @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "empleados_id_usuario_fkey")
  sales            sales[]
}

model general_statuses {
  id_status     Int             @id(map: "estados_generales_pkey") @default(autoincrement())
  name_status   String          @unique(map: "estados_generales_nombre_key") @db.VarChar(50)
  banner_img    banner_img[]
  categories    categories[]
  employees     employees[]
  products      products[]
  providers     providers[]
  roles         roles[]
  subcategories subcategories[]
  users         users[]
}

model hedv {
  id_return_status      Int                 @id @default(autoincrement())
  id_sale_return_detail Int
  status                String              @db.VarChar(50)
  status_date           DateTime?           @default(dbgenerated("CURRENT_DATE")) @db.Date
  sale_return_details   sale_return_details @relation(fields: [id_sale_return_detail], references: [id_sale_return_detail], onDelete: NoAction, onUpdate: NoAction, map: "hedv_id_detalle_fkey")
}

model hev {
  id_order        Int           @id
  id_sales_return Int?
  id_sale_status  Int
  status_date     DateTime?     @default(dbgenerated("CURRENT_DATE")) @db.Date
  sale_statuses   sale_statuses @relation(fields: [id_sale_status], references: [id_sale_status], onDelete: NoAction, onUpdate: NoAction, map: "hev_estado_venta_fkey")
  sales_orders    sales_orders  @relation(fields: [id_order], references: [id_order], onDelete: NoAction, onUpdate: NoAction, map: "hev_id_pedido_fkey")
}

model hsp {
  id_history_status_purchase Int               @id(map: "hec_pkey") @default(autoincrement())
  id_purchase_return         Int
  id_purchase_status         Int
  status_date                DateTime?         @default(dbgenerated("CURRENT_DATE")) @db.Date
  id_purchase_detail         Int
  purchases_returns          purchases_returns @relation(fields: [id_purchase_return], references: [id_purchase_return], onDelete: Cascade, map: "fk_hec_devolucion_compra")
  purchase_statuses          purchase_statuses @relation(fields: [id_purchase_status], references: [id_purchase_status], map: "fk_hec_estado_compra")
  purchase_details           purchase_details  @relation(fields: [id_purchase_detail], references: [id_purchase_detail], onDelete: NoAction, onUpdate: NoAction, map: "hec_id_detalle_compra_fkey")
}

model installments {
  id_installment     Int             @id(map: "abonos_pkey") @default(autoincrement())
  id_sale            Int
  installment_amount Decimal         @db.Decimal(12, 2)
  installment_date   DateTime?       @default(dbgenerated("CURRENT_DATE")) @db.Date
  id_payment_method  Int
  observations       String?         @db.VarChar(255)
  remaining_balance  Decimal         @db.Decimal(12, 2)
  id_credit_status   Int
  id_credit          Int
  payment_methods    payment_methods @relation(fields: [id_payment_method], references: [id_payment_method], onDelete: NoAction, onUpdate: NoAction, map: "abonos_id_metodo_pago_fkey")
  credits            credits         @relation(fields: [id_credit], references: [id_credit], onDelete: Cascade, map: "fk_abonos_credito")
  credit_statuses    credit_statuses @relation(fields: [id_credit_status], references: [id_credit_status], map: "fk_abonos_estado_credito")
}

model modules {
  id_module            Int                    @id(map: "modulos_pkey") @default(autoincrement())
  name_module          String                 @unique(map: "modulos_nombre_modulo_key") @db.VarChar(50)
  description          String?                @db.VarChar(100)
  assigned_permissions assigned_permissions[]
}

model non_conforming_products {
  id_ncp            Int        @id(map: "producto_no_conforme_pkey") @default(autoincrement())
  affected_quantity Int
  detection_date    DateTime?  @default(dbgenerated("CURRENT_DATE")) @db.Date
  report_reason     String     @db.VarChar(255)
  id_barcode        Int
  id_category       Int
  categories        categories @relation(fields: [id_category], references: [id_category], map: "fk_pnc_categoria")
  barcodes          barcodes   @relation(fields: [id_barcode], references: [id_barcode], onDelete: NoAction, onUpdate: NoAction, map: "producto_no_conforme_id_codigo_producto_fkey")
}

model order_details {
  id_order_detail Int          @id(map: "detalles_pedidos_pkey") @default(autoincrement())
  id_order        Int
  barcode         String       @db.VarChar(100)
  quantity        Int
  unit_price      Decimal      @db.Decimal(10, 2)
  subtotal        Decimal      @db.Decimal(10, 2)
  iva_amount      Decimal      @db.Decimal(10, 2)
  id_product      Int
  sales_orders    sales_orders @relation(fields: [id_order], references: [id_order], onDelete: NoAction, onUpdate: NoAction, map: "detalles_pedidos_id_pedido_fkey")
  products        products     @relation(fields: [id_product], references: [id_product], map: "fk_detalle_producto")
}

model order_statuses {
  id_order_status Int            @id(map: "estados_pedidos_pkey") @default(autoincrement())
  name_status     String         @unique(map: "estados_pedidos_nombre_key") @db.VarChar(50)
  description     String?        @db.VarChar(100)
  sales_orders    sales_orders[]
}

model payment_methods {
  id_payment_method   Int            @id(map: "metodos_pago_pkey") @default(autoincrement())
  name_payment_method String         @unique(map: "metodos_pago_nombre_key") @db.VarChar(50)
  installments        installments[]
  sales               sales[]
}

model prd {
  id_purchase_return_details Int               @id(map: "detalle_devolucion_compra_pkey") @default(autoincrement())
  id_purchase_return         Int
  barcode                    String            @db.VarChar(100)
  quantity                   Int
  supplier_date              DateTime?         @db.Date
  id_return_reason           Int
  id_return_method           Int
  id_return_status           Int
  id_product                 Int
  purchases_returns          purchases_returns @relation(fields: [id_purchase_return], references: [id_purchase_return], onDelete: NoAction, onUpdate: NoAction, map: "detalle_devolucion_compra_id_devolucion_compra_fkey")
  return_statuses            return_statuses   @relation(fields: [id_return_status], references: [id_return_status], onDelete: NoAction, onUpdate: NoAction, map: "detalle_devolucion_compra_id_estado_devolucion_fkey")
  return_methods             return_methods    @relation(fields: [id_return_method], references: [id_return_method], onDelete: NoAction, onUpdate: NoAction, map: "detalle_devolucion_compra_id_metodo_devolucion_fkey")
  return_reasons             return_reasons    @relation(fields: [id_return_reason], references: [id_return_reason], onDelete: NoAction, onUpdate: NoAction, map: "detalle_devolucion_compra_id_motivo_devolucion_fkey")
  products                   products          @relation(fields: [id_product], references: [id_product], map: "fk_ddc_producto")
  prsh                       prsh[]
}

model privileges {
  id_privilege         Int                    @id(map: "privilegios_pkey") @default(autoincrement())
  name_privilege       String                 @unique(map: "privilegios_nombre_privilegio_key") @db.VarChar(50)
  description          String?                @db.VarChar(100)
  assigned_permissions assigned_permissions[]
}

model product_suppliers {
  id_product_supplier Int       @id(map: "productos_proveedores_pkey") @default(autoincrement())
  id_product          Int
  id_supplier         Int
  products            products  @relation(fields: [id_product], references: [id_product], onDelete: NoAction, onUpdate: NoAction, map: "productos_proveedores_id_producto_fkey")
  providers           providers @relation(fields: [id_supplier], references: [id_provider], onDelete: NoAction, onUpdate: NoAction, map: "productos_proveedores_id_proveedor_fkey")

  @@unique([id_product, id_supplier], map: "productos_proveedores_id_producto_id_proveedor_key")
}

model product_unit_measures {
  id_product      Int
  id_unit_measure Int
  products        products      @relation(fields: [id_product], references: [id_product], onDelete: Cascade, map: "fk_pum_producto")
  unit_measures   unit_measures @relation(fields: [id_unit_measure], references: [id_unit_measure], map: "fk_pum_unidad_medida")

  @@id([id_product, id_unit_measure], map: "producto_unidad_medida_pkey")
}

model products {
  id_product            Int                     @id(map: "productos_pkey") @default(autoincrement())
  name                  String                  @db.VarChar(255)
  reference             String                  @unique(map: "productos_referencia_key") @db.VarChar(50)
  stock                 Int?                    @default(0)
  retail_price          Decimal                 @db.Decimal(10, 2)
  wholesale_price       Decimal                 @db.Decimal(10, 2)
  id_unit_measure       Int
  iva_percentage        Decimal?                @default(0) @db.Decimal(5, 2)
  id_status             Int
  id_category           Int
  partner_price         Decimal?                @db.Decimal(10, 2)
  bulk_price            Decimal?                @db.Decimal(10, 2)
  barcodes              barcodes[]
  order_details         order_details[]
  prd                   prd[]
  product_suppliers     product_suppliers[]
  product_unit_measures product_unit_measures[]
  categories            categories              @relation(fields: [id_category], references: [id_category], onDelete: NoAction, onUpdate: NoAction, map: "productos_id_categoria_fkey")
  general_statuses      general_statuses        @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction, map: "productos_id_estado_fkey")
  unit_measures         unit_measures           @relation(fields: [id_unit_measure], references: [id_unit_measure], onDelete: NoAction, onUpdate: NoAction, map: "productos_id_unidad_medida_fkey")
}

model providers {
  id_provider           Int                 @id(map: "proveedores_pkey") @default(autoincrement())
  person_type           String              @db.VarChar(25)
  rut                   Boolean?            @default(false)
  ciu_code              String?             @db.VarChar(30)
  address               String?             @db.VarChar(255)
  contact_person_name   String?             @db.VarChar(255)
  contact_person_number BigInt?
  id_status             Int?
  email                 String?             @db.VarChar(150)
  phone                 String?             @db.VarChar(20)
  document_type         String?             @db.VarChar(20)
  document_number       String?             @db.VarChar(20)
  name_provider         String?             @db.VarChar(100)
  lastname              String?             @db.VarChar(100)
  max_return_period     Int?
  product_suppliers     product_suppliers[]
  general_statuses      general_statuses?   @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction, map: "proveedores_id_estado_fkey")
  purchases             purchases[]
}

model prsh {
  id_status_history Int       @id(map: "hedc_pkey") @default(autoincrement())
  id_detail         Int
  status            String    @db.VarChar(50)
  status_date       DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  prd               prd       @relation(fields: [id_detail], references: [id_purchase_return_details], onDelete: NoAction, onUpdate: NoAction, map: "hedc_id_detalle_fkey")
}

model purchase_details {
  id_purchase_detail  Int       @id(map: "detalle_compra_pkey") @default(autoincrement())
  id_purchase         Int
  id_barcode          Int
  quantity            Int
  gross_unit_price    Decimal   @db.Decimal(10, 2)
  tax_unit_price      Decimal   @db.Decimal(10, 2)
  net_unit_price      Decimal   @db.Decimal(10, 2)
  gross_subtotal      Decimal   @db.Decimal(10, 2)
  iva_subtotal        Decimal   @db.Decimal(10, 2)
  net_subtotal        Decimal   @db.Decimal(10, 2)
  tax_percentage      Decimal   @db.Decimal(5, 2)
  batch_code          String    @db.VarChar(50)
  cancellation_reason String?   @db.VarChar(250)
  hsp                 hsp[]
  barcodes            barcodes  @relation(fields: [id_barcode], references: [id_barcode], onDelete: NoAction, onUpdate: NoAction, map: "detalle_compra_id_codigo_producto_fkey")
  purchases           purchases @relation(fields: [id_purchase], references: [id_purchase], onDelete: NoAction, onUpdate: NoAction, map: "detalle_compra_id_compra_fkey")
}

model purchase_statuses {
  id_purchase_status  Int         @id(map: "estados_compras_pkey") @default(autoincrement())
  name_puchase_status String      @unique(map: "estados_compras_nombre_key") @db.VarChar(50)
  hsp                 hsp[]
  purchases           purchases[]
}

model purchases {
  id_purchase        Int                 @id(map: "compras_pkey") @default(autoincrement())
  invoice_number     String              @unique(map: "compras_no_recibo_key") @db.VarChar(50)
  purchase_date      DateTime?           @default(dbgenerated("CURRENT_DATE")) @db.Date
  total_amount       Decimal?            @default(0) @db.Decimal(12, 2)
  id_provider        Int
  id_purchase_status Int
  purchase_details   purchase_details[]
  providers          providers           @relation(fields: [id_provider], references: [id_provider], onDelete: NoAction, onUpdate: NoAction, map: "compras_id_proveedor_fkey")
  purchase_statuses  purchase_statuses   @relation(fields: [id_purchase_status], references: [id_purchase_status], map: "fk_compras_estado")
  purchases_returns  purchases_returns[]
}

model purchases_returns {
  id_purchase_return Int             @id(map: "devoluciones_compras_pkey") @default(autoincrement())
  id_purchase        Int
  creation_date      DateTime?       @default(dbgenerated("CURRENT_DATE")) @db.Date
  id_return_status   Int
  hsp                hsp[]
  prd                prd[]
  purchases          purchases       @relation(fields: [id_purchase], references: [id_purchase], onDelete: NoAction, onUpdate: NoAction, map: "devoluciones_compras_id_compra_fkey")
  return_statuses    return_statuses @relation(fields: [id_return_status], references: [id_return_status], onDelete: NoAction, onUpdate: NoAction, map: "devoluciones_compras_id_estado_devolucion_fkey")
}

model return_methods {
  id_return_method    Int                   @id(map: "metodo_devolucion_pkey") @default(autoincrement())
  description         String                @unique(map: "metodo_devolucion_descripcion_key") @db.VarChar(50)
  prd                 prd[]
  sale_return_details sale_return_details[]
}

model return_reasons {
  id_return_reason    Int                   @id(map: "motivos_devolucion_pkey") @default(autoincrement())
  description         String                @unique(map: "motivos_devolucion_descripcion_key") @db.VarChar(50)
  prd                 prd[]
  sale_return_details sale_return_details[]
}

model return_statuses {
  id_return_status     Int                   @id(map: "estado_devoluciones_pkey") @default(autoincrement())
  name_status          String                @unique(map: "estado_devoluciones_nombre_key") @db.VarChar(25)
  purchase_description String?               @db.VarChar(255)
  sales_description    String?               @db.VarChar(255)
  prd                  prd[]
  purchases_returns    purchases_returns[]
  sale_return_details  sale_return_details[]
  sales_returns        sales_returns[]
}

model roles {
  id_role              Int                    @id @default(autoincrement())
  name_role            String                 @unique(map: "roles_nombre_rol_key") @db.VarChar(20)
  description          String?                @db.VarChar(50)
  date_creation        DateTime?              @default(dbgenerated("CURRENT_DATE")) @db.Date
  id_status            Int
  assigned_permissions assigned_permissions[]
  general_statuses     general_statuses       @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction, map: "fk_roles_estado")
}

model sale_return_details {
  id_sale_return_detail Int             @id(map: "detalle_devolucion_venta_pkey") @default(autoincrement())
  id_sales_return       Int
  barcode               String          @db.VarChar(100)
  quantity              Int
  id_return_reason      Int
  id_return_method      Int
  id_return_status      Int
  cancellation_reason   String?         @db.VarChar(250)
  id_barcode            Int?
  hedv                  hedv[]
  sales_returns         sales_returns   @relation(fields: [id_sales_return], references: [id_sales_return], onDelete: NoAction, onUpdate: NoAction, map: "detalle_devolucion_venta_id_devolucion_venta_fkey")
  return_statuses       return_statuses @relation(fields: [id_return_status], references: [id_return_status], onDelete: NoAction, onUpdate: NoAction, map: "detalle_devolucion_venta_id_estado_devolucion_fkey")
  return_methods        return_methods  @relation(fields: [id_return_method], references: [id_return_method], onDelete: NoAction, onUpdate: NoAction, map: "detalle_devolucion_venta_id_metodo_devolucion_fkey")
  return_reasons        return_reasons  @relation(fields: [id_return_reason], references: [id_return_reason], onDelete: NoAction, onUpdate: NoAction, map: "detalle_devolucion_venta_id_motivo_devolucion_fkey")
  barcodes              barcodes?       @relation(fields: [id_barcode], references: [id_barcode], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_dev_codigo_barras")
}

model sale_return_evidence {
  id_evidence       Int           @id(map: "evidencia_devolucion_ventas_pkey") @default(autoincrement())
  image_path        String        @unique(map: "evidencia_devolucion_ventas_ruta_imagen_key") @db.VarChar(255)
  image_description String?       @db.VarChar(255)
  id_sales_return   Int
  sales_returns     sales_returns @relation(fields: [id_sales_return], references: [id_sales_return], onDelete: NoAction, onUpdate: NoAction, map: "evidencia_devolucion_ventas_id_devolucion_venta_fkey")
}

model sale_statuses {
  id_sale_status Int     @id(map: "estados_ventas_pkey") @default(autoincrement())
  name_status    String  @unique(map: "estados_ventas_nombre_key") @db.VarChar(50)
  description    String? @db.VarChar(100)
  hev            hev[]
  sales          sales[]
}

model sales {
  id_sale           Int             @id(map: "ventas_pkey") @default(autoincrement())
  id_order          Int?            @unique(map: "ventas_id_pedido_key")
  id_employe        Int
  id_payment_method Int
  subtotal          Decimal         @db.Decimal(12, 2)
  sale_date         DateTime?       @default(dbgenerated("CURRENT_DATE")) @db.Date
  id_sale_status    Int
  sale_type         String?         @db.VarChar(50)
  credits           credits?
  employees         employees       @relation(fields: [id_employe], references: [id_employee], onDelete: NoAction, onUpdate: NoAction, map: "ventas_id_empleado_vendedor_fkey")
  sale_statuses     sale_statuses   @relation(fields: [id_sale_status], references: [id_sale_status], onDelete: NoAction, onUpdate: NoAction, map: "ventas_id_estado_venta_fkey")
  payment_methods   payment_methods @relation(fields: [id_payment_method], references: [id_payment_method], onDelete: NoAction, onUpdate: NoAction, map: "ventas_id_metodo_pago_fkey")
  sales_orders      sales_orders?   @relation(fields: [id_order], references: [id_order], onDelete: NoAction, onUpdate: NoAction, map: "ventas_id_pedido_fkey")
  sales_returns     sales_returns[]
}

model sales_orders {
  id_order         Int             @id(map: "pedidos_venta_pkey") @default(autoincrement())
  id_customer      Int
  order_date       DateTime?       @default(dbgenerated("CURRENT_DATE")) @db.Date
  delivery_address String?         @db.VarChar(255)
  id_order_status  Int
  hev              hev?
  order_details    order_details[]
  sales            sales?
  clients          clients         @relation(fields: [id_customer], references: [id_client], onDelete: NoAction, onUpdate: NoAction, map: "pedidos_venta_id_cliente_fkey")
  order_statuses   order_statuses  @relation(fields: [id_order_status], references: [id_order_status], onDelete: NoAction, onUpdate: NoAction, map: "pedidos_venta_id_estado_pedido_fkey")
}

model sales_returns {
  id_sales_return      Int                    @id(map: "devoluciones_ventas_pkey") @default(autoincrement())
  id_sale              Int
  creation_date        DateTime?              @default(dbgenerated("CURRENT_DATE")) @db.Date
  id_return_status     Int
  sale_return_details  sale_return_details[]
  sale_return_evidence sale_return_evidence[]
  return_statuses      return_statuses        @relation(fields: [id_return_status], references: [id_return_status], onDelete: NoAction, onUpdate: NoAction, map: "devoluciones_ventas_id_estado_devolucion_fkey")
  sales                sales                  @relation(fields: [id_sale], references: [id_sale], onDelete: NoAction, onUpdate: NoAction, map: "devoluciones_ventas_id_venta_fkey")
}

model subcategories {
  id_subcategory   Int              @id(map: "subcategorias_pkey") @default(autoincrement())
  name_subcategory String           @db.VarChar(100)
  description      String?          @db.VarChar(250)
  id_status        Int
  id_category      Int
  categories       categories       @relation(fields: [id_category], references: [id_category], onDelete: NoAction, onUpdate: NoAction, map: "fk_subcategorias_categoria")
  general_statuses general_statuses @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction, map: "fk_subcategorias_estado")
}

model unit_measures {
  id_unit_measure       Int                     @id(map: "unidad_medida_pkey") @default(autoincrement())
  name_unit_measure     String                  @unique(map: "unidad_medida_nombre_key") @db.VarChar(50)
  abbreviation          String                  @unique(map: "unidad_medida_abreviado_key") @db.VarChar(3)
  product_unit_measures product_unit_measures[]
  products              products[]
}

model users {
  id_user          Int               @id(map: "usuarios_pkey") @default(autoincrement())
  doc_type         String            @db.VarChar(3)
  doc_number       BigInt            @unique(map: "usuarios_documento_key")
  full_name        String            @db.VarChar(255)
  email            String            @unique(map: "usuarios_correo_electronico_key") @db.VarChar(255)
  pass_word        String            @db.VarChar(255)
  creation_date    DateTime?         @default(dbgenerated("CURRENT_DATE")) @db.Date
  phone            BigInt?
  id_status        Int?
  access           access[]
  banner_img       banner_img[]
  clients          clients?
  employees        employees?
  general_statuses general_statuses? @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction, map: "usuarios_id_estado_fkey")
}
