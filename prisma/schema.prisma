  employees            employees              @relation(fields: [id_employe], references: [id_employee], onDelete: NoAction, onUpdate: NoAction, map: "ventas_id_empleado_vendedor_fkey")
  sale_statuses        sale_statuses          @relation(fields: [id_sale_status], references: [id_sale_status], onDelete: NoAction, onUpdate: NoAction, map: "ventas_id_estado_venta_fkey")
  sales_orders         sales_orders           @relation(fields: [id_order], references: [id_order], onDelete: NoAction, onUpdate: NoAction, map: "ventas_id_pedido_fkey")
  sale_types           sale_types             @relation(fields: [id_sale_type], references: [id_sale_type], onDelete: NoAction, onUpdate: NoAction, map: "ventas_id_tipo_venta_fkey")
  sales_returns        sales_returns[]
}

model sales_orders {
  id_order                  Int              @id(map: "pedidos_venta_pkey") @default(autoincrement())
  id_customer               Int
  order_date                DateTime?        @default(dbgenerated("CURRENT_DATE")) @db.Date
  id_order_status           Int
  delivery_adress           String?          @db.VarChar(255)
  subtotal                  Decimal?         @default(0) @db.Decimal(12, 2)
  iva_amount                Decimal?         @default(0) @db.Decimal(12, 2)
  total                     Decimal?         @default(0) @db.Decimal(12, 2)
  payment_status            String?          @default("Pendiente") @db.VarChar(20)
  delivery_type             String?          @default("Recoge") @db.VarChar(20)
  assigned_employee         Int?
  payment_deadline          DateTime?        @db.Timestamp(6)
  payment_reminder_6h_sent  Boolean          @default(false)
  payment_reminder_1h_sent  Boolean          @default(false)
  payment_expired_at        DateTime?        @db.Timestamp(6)
  payment_expiration_reason String?          @db.VarChar(255)
  id_payment_status         Int
  cancellation_reason       String?          @db.VarChar(255)
  cancelled_at              DateTime?        @db.Timestamp(6)
