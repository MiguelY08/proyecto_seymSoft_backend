  order_payments            order_payments[]
  sales                     sales?
  employees                 employees?       @relation(fields: [assigned_employee], references: [id_employee], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_employee")
  payment_statuses          payment_statuses @relation(fields: [id_payment_status], references: [id_payment_status], onDelete: NoAction, onUpdate: NoAction, map: "fk_sales_orders_payment_status")
  clients                   clients          @relation(fields: [id_customer], references: [id_client], onDelete: NoAction, onUpdate: NoAction, map: "pedidos_venta_id_cliente_fkey")
  order_statuses            order_statuses   @relation(fields: [id_order_status], references: [id_order_status], onDelete: NoAction, onUpdate: NoAction, map: "pedidos_venta_id_estado_pedido_fkey")
}

